{
  "name": "university-research-dashboard",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "28.0.0-nightly202611270089699ae3 || 28.0.0-nightly20261126fa49b1361b",
    "npm": "12.2.3",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @urd/api --filter @urd/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @urd/api db:generate",
    "db:migrate": "pnpm --filter @urd/api db:migrate",
    "db:test": "pnpm --filter @urd/api db:test",
    "db:studio": "pnpm --filter @urd/api db:studio",
    "data:check": "./scripts/check-data-quality.sh",
    "data:status": "./scripts/export-data-status.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "prettier": "4.0.0-alpha.13",
    "typescript": "7.1.0-dev.20261127.1"
  }
}
