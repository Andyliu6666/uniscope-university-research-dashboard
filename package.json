{
  "name": "university-research-dashboard",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.23 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @urd/api --filter @urd/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @urd/api db:generate",
    "db:migrate": "pnpm --filter @urd/api db:migrate",
    "db:seed": "pnpm --filter @urd/api db:seed",
    "db:studio": "pnpm --filter @urd/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
