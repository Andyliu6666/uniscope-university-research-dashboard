{
  "$schema": "https://raw.githubusercontent.com/biomejs/biome/100d4d7fa9f95f701c47e6734b00553e4de0b9c6/packages/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!data/sources/**/*.jsonl",
      "!!data/sources/taiwan-moe-114.json",
      "!!data/sources/taiwan-moe-departments-114.json",
      "!!data/sources/taiwan-moe-students-113-114.json",
      "!!data/sources/taiwan-moe-tuition-114.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  }
}
