{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!data/sources/**/*.jsonl",
      "!!data/sources/taiwan-moe-114.json",
      "!!data/sources/taiwan-moe-departments-114.json",
      "!!data/sources/taiwan-moe-students-113-114.json",
      "!!data/sources/taiwan-moe-tuition-114.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  }
}
