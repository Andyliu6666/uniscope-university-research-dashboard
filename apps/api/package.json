{
  "name": "@urd/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "import": "tsx src/scripts/import-universities.ts",
    "import:ib": "tsx src/scripts/import-ib-requirements.ts",
    "import:admissions-facts": "tsx src/scripts/import-admissions-facts.ts",
    "build:ror-core": "tsx src/scripts/build-ror-core-artifact.ts",
    "build:openalex-research": "tsx src/scripts/build-openalex-institution-artifact.ts",
    "build:taiwan-moe": "tsx src/scripts/build-taiwan-moe-artifact.ts",
    "build:taiwan-moe-enrichment": "tsx src/scripts/build-taiwan-moe-enrichment-artifacts.ts",
    "import:ror": "tsx src/scripts/import-ror.ts",
    "import:ror-core": "tsx src/scripts/import-ror-core.ts",
    "import:openalex-research": "tsx src/scripts/import-openalex-research.ts",
    "import:taiwan-moe": "tsx src/scripts/import-taiwan-moe.ts",
    "import:taiwan-moe-enrichment": "tsx src/scripts/import-taiwan-moe-enrichment.ts",
    "import:ipeds": "tsx src/scripts/import-ipeds.ts",
    "import:ipeds-core": "tsx src/scripts/import-ipeds-core.ts",
    "import:ipeds-admissions": "tsx src/scripts/import-ipeds-admissions.ts",
    "import:ipeds-cost": "tsx src/scripts/import-ipeds-cost.ts",
    "import:ipeds-enrollment": "tsx src/scripts/import-ipeds-enrollment.ts",
    "import:ipeds-programs": "tsx src/scripts/import-ipeds-programs.ts",
    "import:wikidata-ror-crosswalk": "tsx src/scripts/import-wikidata-ror-crosswalk.ts",
    "import:wikidata-enrichment": "tsx src/scripts/import-wikidata-enrichment.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@urd/shared": "workspace:*",
    "csv-parse": "7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  }
}
