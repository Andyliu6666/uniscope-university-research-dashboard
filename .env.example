# Copy this file to .env for Docker Compose.
COMPOSE_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=university_dashboard
POSTGRES_USER=urd
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://urd:change-me-in-production@localhost:5432/university_dashboard
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
# Maintainer writes are opt-in. Generate a long random key before setting this to true.
ADMIN_WRITES_ENABLED=false
ADMIN_KEY=
# Keep false unless the API is behind a proxy you control. A comma-separated IP/CIDR list is accepted.
TRUST_PROXY=false
VITE_API_URL=http://localhost:3001
