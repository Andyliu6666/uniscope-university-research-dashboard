  "profiles": [
    {
      "academicYear": "2027",
      "intakeTerm": "september",
      "entryType": "first_year",
      "applicantType": "all",
      "institutionKey": "bath",
      "programId": null,
      "level": "undergraduate",
      "notes": "September 2027 first-year Architecture, Civil Engineering and Structural and Architectural Engineering routes.",
      "requirements": [
        {
          "key": "bath_27_ca_engineering_alevel",
          "label": "A levels · civil and structural engineering",
          "details": "A*AA across three A levels including Mathematics. The contextual offer is AAB with A in Mathematics. Bath can accept the Advanced Skills Baccalaureate Wales in place of an A level, with an exception where it is studied only alongside Mathematics and Further Mathematics.",
          "category": "academic",
          "status": "conditional",
          "source": {
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/civil-engineering/beng-civil-engineering-with-professional-placement/",
            "title": "Bath 2027 · Civil Engineering BEng (Hons) with professional placement · A level offers",
            "checkedOn": "2026-11-20"
          }
        },
        {
          "key": "bath_27_ca_engineering_alternative",
          "label": "A levels · engineering alternative offers",
          "details": "AAA or A*AB with A in Mathematics plus an approved additional qualification. The listed examples are EPQ or IEPQ at A, eligible AS Further Mathematics at A, or an additional A level at B where the four include Further Mathematics. The separate Welsh qualification alternatives are AAAB or A*ABB including B in the Advanced Skills Baccalaureate Wales.",
          "category": "academic",
          "status": "conditional",
          "source": {
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/civil-engineering/beng-civil-engineering-with-professional-placement/",
            "title": "Bath 2027 · Civil Engineering BEng (Hons) with professional placement · A level alternative offer",
            "checkedOn": "2026-11-20"
          }
        },
        {
          "key": "bath_27_ca_engineering_ap",
          "label": "US Advanced Placement · engineering",
          "details": "Three AP grades of 5, including Calculus BC. Calculus AB, AP Seminar and AP Research cannot count toward these three. Bath assesses the wider academic record individually. Relevant honours or dual-enrolment courses may be considered if the specified AP exams are unavailable, and an associate degree at GPA 3.5 with sufficient Mathematics credits is considered individually.",
          "category": "standardized_test",
          "status": "conditional",
          "source": {
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/civil-engineering/beng-civil-engineering-with-professional-placement/",
            "title": "Bath 2027 · Civil Engineering BEng (Hons) with professional placement · US qualifications",
            "checkedOn": "2026-11-20"
          }
        },
        {
          "key": "bath_27_ca_engineering_btec",
          "label": "BTEC · engineering",
          "details": "RQF National Extended Diploma D*DD plus A-level Mathematics at A. Construction and the Built Environment or Building Services is preferred. Engineering and Applied Science can also be considered.",
          "category": "academic",
          "status": "conditional",
          "source": {
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/civil-engineering/beng-civil-engineering-with-professional-placement/",
            "title": "Bath 2027 · Civil Engineering BEng (Hons) with professional placement · BTEC typical offer",
            "checkedOn": "2026-11-20"
          }
        },
        {
          "key": "bath_27_ca_engineering_t_level",
          "label": "T Level · engineering",
          "details": "Distinction* overall with core A* plus A-level Mathematics at A. Accepted T Levels are Design, Surveying and Planning for Construction, or Building Services Engineering for Construction. The former prefers the Surveying and Design or Civil Engineering specialisms. Suitable T Level applicants are interviewed.",
          "category": "academic",
          "status": "conditional",
          "source": {
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/civil-engineering/beng-civil-engineering-with-professional-placement/",
            "title": "Bath 2027 · Civil Engineering BEng (Hons) with professional placement · T Level typical offer",
            "checkedOn": "2026-11-20"
          }
        },
        {
          "key": "bath_27_ca_engineering_access",
          "label": "Access to HE · engineering",
          "details": "At least 39 credits at Distinction, including 12 Distinction Mathematics credits covering Calculus. Suitable Access applicants are interviewed.",
          "category": "academic",
          "status": "conditional",
          "source": {
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/civil-engineering/beng-civil-engineering-with-professional-placement/",
            "title": "Bath 2027 · Civil Engineering BEng (Hons) with professional placement · Access to HE Diploma",
            "checkedOn": "2026-11-20"
          }
        },
        {
          "key": "bath_27_ca_engineering_scottish",
          "label": "Scottish Advanced Highers · engineering",
          "details": "AA in two Advanced Highers including Mathematics. Bath normally expects five Highers and prefers AAAAA.",
          "category": "academic",
          "status": "conditional",
          "source": {
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/civil-engineering/beng-civil-engineering-with-professional-placement/",
            "title": "Bath 2027 · Civil Engineering BEng (Hons) with professional placement · Scottish Highers",
            "checkedOn": "2026-11-20"
          }
        },
        {
          "key": "bath_27_ca_engineering_selection",
          "label": "Engineering · UCAS selection",
          "details": "Selection usually uses the UCAS application. Suitable applicants with Access to HE or T Level qualifications are invited to interview.",
          "category": "application",
          "status": "conditional",
          "source": {
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/civil-engineering/beng-civil-engineering-with-professional-placement/",
            "title": "Bath 2027 · Civil Engineering BEng (Hons) with professional placement · Selection process",
            "checkedOn": "2026-11-20"
          }
        },
        {
          "key": "bath_27_ca_architecture_alevel",
          "label": "A levels · Architecture",
          "details": "A*AA across three A levels including A in Mathematics or Physics. The contextual offer is AAB including A in Mathematics or Physics. Bath can accept the Advanced Skills Baccalaureate Wales in place of an A level, with an exception where it is studied only alongside Mathematics and Further Mathematics.",
          "category": "academic",
          "status": "conditional",
