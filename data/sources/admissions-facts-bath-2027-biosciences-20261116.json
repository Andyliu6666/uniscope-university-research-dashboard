      "requirements": [
        {
          "key": "bath_27_bio_gcse",
          "label": "Biosciences · GCSE Mathematics",
          "details": "The GCSE Mathematics benchmark is grade 4/C.",
          "source": {
            "title": "Bath 2027 · Biochemistry BSc (Hons) · British qualifications",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biochemistry/",
            "checkedOn": "2026-11-16"
          },
          "category": "academic",
          "status": "required"
        },
        {
          "key": "bath_27_bio_supplement",
          "label": "Supplementary qualifications · alternative GCE offers",
          "details": "When paired with the course-specific alternative A-level grades, accepted routes include EPQ or IEPQ at A, Core Mathematics at B, AS Mathematics or Statistics at B where the subject is not already at A level, a fourth A level at B where the four include Mathematics or Statistics, or another approved project.",
          "source": {
            "title": "Bath 2027 · Biochemistry BSc (Hons) · British qualifications",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biochemistry/",
            "checkedOn": "2026-11-16"
          },
          "category": "academic",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_ap_subjects",
          "label": "AP subject counting and transcript review",
          "details": "At most one Calculus AP counts. AP Seminar and AP Research are excluded. Bath can consider honours, dual enrolment or equivalent advanced classes individually and asks for a transcript when reviewing alternatives.",
          "source": {
            "title": "Bath 2027 · Biology BSc (Hons) · American qualifications",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biology/",
            "checkedOn": "2026-11-16"
          },
          "category": "standardized_test",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_chem_statement",
          "label": "Biochemistry · UCAS personal statement",
          "details": "Show interest in Biochemistry through academic topics, reading or relevant experience. Applicants with certain qualifications, including a Level 3 BTEC Extended Diploma, are interviewed.",
          "source": {
            "title": "Bath 2027 · Biochemistry BSc (Hons) · Selection process",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biochemistry/",
            "checkedOn": "2026-11-16"
          },
          "category": "application",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_btec_chem",
          "label": "BTEC Applied Science with A levels",
          "details": "The named route is an Applied Science Extended Diploma at DMM plus A in both A-level Biology and A-level Chemistry. Bath may individually consider the content when only one of those A levels accompanies the BTEC.",
          "source": {
            "title": "Bath 2027 · Biochemistry BSc (Hons) · British qualifications",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biochemistry/",
            "checkedOn": "2026-11-16"
          },
          "category": "academic",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_access_33",
          "label": "Access to HE Diploma · Biochemistry and Biology",
          "details": "Use a Science or Science and Engineering diploma with at least 33 credits at Distinction and six at Merit or above. At least 30 Distinction credits must be in STEM. Check the course-level subject rules.",
          "source": {
            "title": "Bath 2027 · Biochemistry BSc (Hons) · British qualifications",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biochemistry/",
            "checkedOn": "2026-11-16"
          },
          "category": "academic",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_chem_alevel",
          "label": "GCE A levels · standard, contextual and alternative offers",
          "details": "AAB with Biology A and Chemistry A. UK fee-eligible contextual applicants can receive BBB or ABC with both subjects at least B. The supplementary qualification route is ABB with A in either Biology or Chemistry and at least B in the other. The Welsh Baccalaureate alternative is ABBB including the required subjects and B in the Advanced Skills Baccalaureate Wales.",
          "source": {
            "title": "Bath 2027 · Biochemistry BSc (Hons) · British qualifications",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biochemistry/",
            "checkedOn": "2026-11-16"
          },
          "category": "academic",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_chem_ap",
          "label": "US Advanced Placement · typical offer",
          "details": "AP grades 5/5/4, with 5 in each of Biology and Chemistry. An associate degree may be considered at GPA 3.2 with sufficient credits in Biology and Chemistry.",
          "source": {
            "title": "Bath 2027 · Biochemistry BSc (Hons) · American qualifications",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biochemistry/",
            "checkedOn": "2026-11-16"
          },
          "category": "standardized_test",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_chem_other",
          "label": "Other British qualifications",
          "details": "AB in Advanced Higher Biology and Chemistry. Bath typically assesses five Scottish Highers and prefers at least AAAAB.",
          "source": {
            "title": "Bath 2027 · Biochemistry BSc (Hons) · British qualifications",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biochemistry/",
            "checkedOn": "2026-11-16"
          },
          "category": "academic",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_biology_statement",
          "label": "Biology · UCAS personal statement",
          "details": "The statement should show interest in Biology. Statements centred on medicine or dentistry are not accepted for this course. The BTEC Extended Diploma and T Level routes can involve an interview.",
          "source": {
            "title": "Bath 2027 · Biology BSc (Hons) · Selection process",
            "url": "https://www.bath.ac.uk/courses/undergraduate-2027/biosciences/bsc-biology/",
            "checkedOn": "2026-11-16"
          },
          "category": "application",
          "status": "conditional"
        },
        {
          "key": "bath_27_bio_biology_alevel",
          "label": "GCE A levels · standard, contextual and alternative offers",
          "details": "AAB with Biology A and A in a second science or mathematics subject. Contextual offer BBB or ABC includes Biology B and B in the second subject. The supplementary qualification route is ABB with Biology A and the second subject at B. The university also lists ABBB with these subjects and B in the Advanced Skills Baccalaureate Wales.",
          "source": {
            "title": "Bath 2027 · Biology BSc (Hons) · British qualifications",
